# DSM settings. Easiest path: run `npm run setup`, which writes .env for you.
# (Or copy this file to .env and fill it in by hand.)

# ── You fill these in ────────────────────────────────────────────
# 2.4 GHz network. Both boards AND this computer must be on it.
WIFI_SSID='your-wifi-name'
WIFI_PASSWORD='your-wifi-password'
# Printed on the first line of each board's serial monitor (npm run monitor:gateway / monitor:lcu).
GATEWAY_MAC='AA:BB:CC:DD:EE:01'
LCU_MAC='AA:BB:CC:DD:EE:02'

# ── Generated (don't share these) ────────────────────────────────
# Any long random strings. `npm run setup` generates them for you.
JWT_SECRET='replace-with-at-least-32-random-characters'
# URL-safe characters only. Compiled into the gateway firmware, so re-flash the gateway if you change it.
GATEWAY_TOKEN='replace-with-a-random-url-safe-token'
# Only used to create the admin account on first start. Change it later in the app.
ADMIN_USERNAME='admin'
ADMIN_PASSWORD='choose-a-password'

# ── Optional ─────────────────────────────────────────────────────
# ADMIN_EMAIL=admin@example.com  # the admin account's email
# PORT=3000  # web server port
# SERVER_HOST=192.168.1.50  # this computer's IP, only if your network blocks mDNS
# DATASET=full  # 'sample' (default) or 'full' after `npm run data:full`
# LCU_CAPACITY_W=3000  # rated power of the load the LCU drives, in watts
